body {
	display: block;
	width: 100%;
	height: 100%;
}

div, p, h1, h2, h3, h4, h5, h6, header, footer, section, nav {
	display: block;
}

em {
	font-style: italic;
}

strong {
	font-weight: bold;
}

select {
	text-align: left;
}

tabset tabs {
	display: block;
}

table {
	box-sizing: border-box;
	display: table;
}

tr {
	box-sizing: border-box;
	display: table-row;
}

td {
	box-sizing: border-box;
	display: table-cell;
}

col {
	box-sizing: border-box;
	display: table-column;
}

colgroup {
	display: table-column-group;
}

thead, tbody, tfoot {
	display: table-row-group;
}
