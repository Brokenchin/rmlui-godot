<rml>
<head>
	<title>Layer & Filter Test</title>
	<link type="text/rcss" href="base.rcss" />
	<style>
		body {
			background-color: #222233;
			font-family: "Noto Sans";
			font-size: 18px;
			color: #ffffff;
		}

		h2 {
			font-size: 22px;
			margin-bottom: 8px;
		}

		.test-label {
			font-size: 14px;
			color: #aaaacc;
			margin-bottom: 4px;
		}

		/* --- Test 1: Opacity on container with overlapping children --- */
		#opacity-container {
			position: absolute;
			left: 40px;
			top: 40px;
			width: 320px;
			padding: 16px;
			background-color: #cc3333;
			opacity: 0.5;
		}

		#opacity-container .child-a {
			width: 180px;
			height: 60px;
			background-color: #3366cc;
			padding: 8px;
			margin-bottom: -20px;
		}

		#opacity-container .child-b {
			width: 180px;
			height: 60px;
			background-color: #33cc33;
			padding: 8px;
			margin-left: 60px;
		}

		/* --- Test 2: Nested opacity --- */
		#nested-opacity {
			position: absolute;
			left: 400px;
			top: 40px;
			width: 280px;
			padding: 16px;
			background-color: #cc8833;
			opacity: 0.7;
		}

		#nested-opacity .inner {
			width: 200px;
			height: 80px;
			background-color: #8833cc;
			padding: 8px;
			opacity: 0.6;
		}

		/* --- Test 3: Full opacity reference --- */
		#full-opacity {
			position: absolute;
			left: 40px;
			top: 240px;
			width: 320px;
			padding: 16px;
			background-color: #cc3333;
		}

		#full-opacity .child-a {
			width: 180px;
			height: 60px;
			background-color: #3366cc;
			padding: 8px;
			margin-bottom: -20px;
		}

		#full-opacity .child-b {
			width: 180px;
			height: 60px;
			background-color: #33cc33;
			padding: 8px;
			margin-left: 60px;
		}

		/* --- Test 4: Opacity on text --- */
		#text-opacity {
			position: absolute;
			left: 400px;
			top: 240px;
			width: 280px;
			padding: 16px;
			background-color: #334455;
			opacity: 0.4;
			font-size: 24px;
		}

		/* --- Test 5: Transform + opacity combo --- */
		#transform-opacity {
			position: absolute;
			left: 220px;
			top: 420px;
			width: 200px;
			height: 100px;
			background-color: #cc33cc;
			padding: 12px;
			opacity: 0.6;
			transform: rotate(15deg);
		}
	</style>
</head>
<body>
	<!-- Test 1: opacity on container should composite children as group -->
	<div id="opacity-container">
		<div class="test-label">Test 1: Container opacity 0.5</div>
		<div class="child-a">Blue overlapping</div>
		<div class="child-b">Green overlapping</div>
	</div>

	<!-- Test 2: Nested opacity should multiply -->
	<div id="nested-opacity">
		<div class="test-label">Test 2: Nested opacity 0.7 * 0.6</div>
		<div class="inner">Inner box (should be very faint)</div>
	</div>

	<!-- Test 3: Same layout at full opacity for comparison -->
	<div id="full-opacity">
		<div class="test-label">Test 3: Full opacity reference</div>
		<div class="child-a">Blue overlapping</div>
		<div class="child-b">Green overlapping</div>
	</div>

	<!-- Test 4: Opacity on text -->
	<div id="text-opacity">
		<div class="test-label">Test 4: Text at 0.4 opacity</div>
		This text should be faint.
	</div>

	<!-- Test 5: Transform + opacity -->
	<div id="transform-opacity">
		<div class="test-label">Test 5: Rotated + 0.6 opacity</div>
		Rotated box
	</div>
</body>
</rml>
