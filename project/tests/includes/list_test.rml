<rml>
<head>
	<title>Array Data Binding Test</title>
	<link type="text/rcss" href="base.rcss" />
	<style>
		body {
			background-color: #1a1a2e;
			font-family: "Noto Sans";
			font-size: 18px;
			color: #ffffff;
		}
		#panel {
			position: absolute;
			left: 50px;
			top: 50px;
			width: 400px;
			padding: 20px;
			background-color: #16213e;
		}
		h1 {
			font-size: 24px;
			margin-bottom: 12px;
			color: #e94560;
		}
		.item-row {
			padding: 4px 8px;
			margin-bottom: 4px;
			background-color: #0f3460;
		}
		#status {
			margin-top: 12px;
			color: #00ff88;
		}
	</style>
</head>
<body data-model="inventory">
	<div id="panel">
		<h1>Array Binding Test</h1>
		<div id="item-list" data-for="item : items">
			<div class="item-row">
				<span>{{ item }}</span>
			</div>
		</div>
		<div id="status">Count: {{ item_count }}</div>
	</div>
</body>
</rml>
