<rml>
<head>
	<title>Context Churn Test</title>
	<link type="text/rcss" href="base.rcss" />
	<style>
		@spritesheet items {
			src: res://addons/rmlui-godot/examples/assets/fruits_atlas.png;
			resolution: 1x;
			item-bone:   0px 0px 16px 16px;
			item-sword: 16px 0px 16px 16px;
			item-pick:  32px 0px 16px 16px;
		}

		body {
			font-family: "Noto Sans";
			font-size: 16px;
			color: #e0e0e0;
			background-color: #1a1a2e;
			padding: 12px;
		}

		h2 { font-size: 20px; color: #ffffff; margin-bottom: 8px; }

		.sprite-row {
			display: flex;
			flex-direction: row;
			gap: 8px;
		}

		.sprite-row img {
			width: 32px;
			height: 32px;
		}

		#canary {
			font-size: 14px;
			color: #44ff44;
			margin-top: 8px;
		}
	</style>
</head>
<body>
	<h2 id="title">Context Churn</h2>
	<div class="sprite-row">
		<img sprite="item-bone" />
		<img sprite="item-sword" />
		<img sprite="item-pick" />
	</div>
	<p id="canary">CANARY — if you can read this, fonts survived</p>
	<p id="status">Waiting...</p>
</body>
</rml>
