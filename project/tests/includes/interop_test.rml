<rml>
<head>
	<title>Interop Test</title>
	<link type="text/rcss" href="base.rcss" />
	<style>
		body {
			background-color: #1a1a2e;
			font-family: "Noto Sans";
			font-size: 14px;
			color: #e0e0e0;
			padding: 8px;
		}

		h2 {
			font-size: 16px;
			color: #ffffff;
			margin-bottom: 6px;
		}

		.info {
			font-size: 12px;
			color: #8888aa;
			margin-bottom: 4px;
		}

		.content-box {
			background-color: #16213e;
			border: 1px #0f3460;
			padding: 8px;
			margin-bottom: 8px;
		}

		.clickable {
			background-color: #0f3460;
			border: 1px #333355;
			padding: 6px 12px;
			margin: 4px;
			transition: background-color 0.2s;
		}

		.clickable:hover {
			background-color: #e94560;
		}

		.counter {
			font-size: 20px;
			color: #e94560;
			margin: 4px 0;
		}

		.status {
			font-size: 11px;
			color: #44ff44;
		}

		.row {
			display: flex;
			flex-direction: row;
			gap: 8px;
		}
	</style>
</head>
<body data-model="interop">
	<h2 data-rml="title">RmlUI Interop Test</h2>
	<div class="info" data-rml="dimensions">...</div>

	<div class="content-box">
		<div class="info">Click counter — verifies input routing works inside container</div>
		<div class="counter" data-rml="click_count">0</div>
		<div class="row">
			<div class="clickable" data-event-click="on_click">Click me</div>
			<div class="clickable" data-event-click="on_reset">Reset</div>
		</div>
	</div>

	<div class="content-box">
		<div class="info">Injected styles — background changes when stylesheet is injected</div>
		<div id="inject-target" class="clickable">Injection target</div>
	</div>

	<div class="content-box">
		<div class="info">Context info</div>
		<div class="status" data-rml="context_status">Waiting...</div>
	</div>
</body>
</rml>
