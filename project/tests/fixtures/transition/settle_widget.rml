<rml>
<head>
<style>
body { width: 100%; height: 100%; background-color: #14202c; }
#epanel {
	display: block; position: absolute; top: 20px; left: 10px;
	width: 90px; height: 60px; background-color: #33bb66;
	transition: transform 0.4s linear-in-out;
}
#epanel.shifted { transform: translateX(150px); }
</style>
</head>
<body>
	<div id="epanel"/>
</body>
</rml>
