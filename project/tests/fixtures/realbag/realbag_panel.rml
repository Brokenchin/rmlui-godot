<rml>
<head>
	<link type="text/rcss" href="res://addons/rmlui-godot/base.rcss" />
	<style>
		/* Self-contained repro of the game bag's clip structure (issue #61 render half):
		   a rounded "tablet" panel (border-radius + overflow:hidden = clip mask) whose
		   middle child scrolls (overflow:auto = scissor), holding rounded slot-boxes
		   (border-radius + overflow:hidden = clip mask) with an in-flow <img>. When a
		   slot scrolls past the scroll viewport, its content is scissor-culled but its
		   rounded clip-mask quad must be too — otherwise it leaks as a white square. */
		body { font-family: "Noto Sans"; }
		#bag-root { position: relative; display: flex; flex-direction: column;
			width: 276px; height: 448px; background-color: #10141e; border: 1px #401722;
			border-radius: 6px; overflow: hidden; }
		.tablet-header { height: 30px; flex-shrink: 0; background-color: #2b0d13; color: #e84560; text-align: center; }
		.bag-scroll { flex-grow: 1; width: 100%; box-sizing: border-box; padding: 8px; overflow-y: auto; }
		.bag-list { display: flex; flex-direction: column; gap: 4px; width: 100%; }
		.slot-grid { display: flex; flex-direction: row; flex-wrap: wrap; }
		.slot { width: 60px; height: 60px; margin: 0; position: relative; }
		.slot-box { box-sizing: border-box; width: 54px; height: 54px; margin: 3px;
			position: relative; background-color: #0c0f16; border: 1px #1d3050;
			border-radius: 3px; overflow: hidden; }
		.slot-icon { display: block; width: 100%; height: 100%; }
	</style>
</head>
<body id="bag-root">
	<div class="tablet-header">Bags</div>
	<div class="bag-scroll">
		<div id="grid" class="bag-list"></div>
	</div>
</body>
</rml>
