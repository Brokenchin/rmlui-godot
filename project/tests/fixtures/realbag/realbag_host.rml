<rml>
<head>
	<link type="text/rcss" href="res://addons/rmlui-godot/base.rcss" />
	<style>
		/* Mirrors panels.rml: the bag is an absolute <embed-doc> in a larger panel
		   context. Positioned with empty space below it so a clip-mask leak past the
		   bag is plainly visible / scannable. */
		body { width: 100%; height: 100%; background-color: #0e2a2a; }
		#panel-bag { position: absolute; left: 40px; top: 40px; }
	</style>
</head>
<body>
	<div id="panel-bag">
		<embed-doc id="bag" src="realbag_panel.rml"/>
	</div>
</body>
</rml>
